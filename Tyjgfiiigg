-- 8. ระบบต่อสู้ & ออกกำลังกายอัตโนมัติ (Auto Q/E Workout)
---------------------------------------------------------
local autoBlockEnabled = false
local autoAttackEnabled = false
local autoWorkoutEnabled = false
local combatDistance = 8 
local isBlocking = false
local lastAttackTick = 0
local attackCooldown = 0.2
local workoutSpeed = 0.15 -- ความเร็วในการกดสลับ Q / E (วินาที)

Tabs.Combat:AddToggle("AutoBlockToggle", {
    Title = "1. เปิด/ปิด บล็อกอัตโนมัติ (Auto Block)",
    Default = false,
    Callback = function(Value)
        autoBlockEnabled = Value
        if not autoBlockEnabled and isBlocking then
            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.F, false, game)
            isBlocking = false
        end
    end
})

Tabs.Combat:AddToggle("AutoAttackToggle", {
    Title = "2. เปิด/ปิด ต่อยสวนกลับอัตโนมัติ (Auto Attack)",
    Default = false,
    Callback = function(Value)
        autoAttackEnabled = Value
    end
})

Tabs.Combat:AddToggle("AutoWorkoutToggle", {
    Title = "3. เปิด/ปิด ออกกำลังกาย Q/E อัตโนมัติ (Auto Workout)",
    Default = false,
    Callback = function(Value)
        autoWorkoutEnabled = Value
    end
})

local CombatDistInput = Tabs.Combat:AddInput("CombatDistInput", {
    Title = "ระยะตรวจจับศัตรู (Studs)",
    Default = "8",
    Placeholder = "เช่น 8, 10, 12",
    Numeric = true,
    Finished = true,
    Callback = function(Value)
        local num = tonumber(Value)
        if num then combatDistance = num end
    end
})

RunService.Heartbeat:Connect(function()
    local char = LocalPlayer.Character
    local myRoot = char and char:FindFirstChild("HumanoidRootPart")
    local enemyNearby = false
    
    if myRoot then
        for _, player in pairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                local enemyRoot = player.Character.HumanoidRootPart
                local distance = (myRoot.Position - enemyRoot.Position).Magnitude
                
                if distance <= combatDistance then
                    enemyNearby = true
                    break
                end
            end
        end
    end
    
    -- ระบบ Auto Block
    if autoBlockEnabled then
        if enemyNearby then
            if not isBlocking then
                VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.F, false, game)
                isBlocking = true
            end
        else
            if isBlocking then
                VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.F, false, game)
                isBlocking = false
            end
        end
    end
    
    -- ระบบ Auto Attack (ต่อยสวนกลับ)
    if autoAttackEnabled and enemyNearby then
        local currentTime = tick()
        if currentTime - lastAttackTick >= attackCooldown then
            lastAttackTick = currentTime
            VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
            task.wait(0.05)
            VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
        end
    end
end)

-- ลูปแยกสำหรับระบบกดปุ่มออกกำลังกาย Q และ E สลับกันอัตโนมัติ
task.spawn(function()
    while true do
        if autoWorkoutEnabled then
            -- กดปุ่ม Q
            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Q, false, game)
            task.wait(0.05)
            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Q, false, game)
            
            task.wait(workoutSpeed)
            
            -- กดปุ่ม E
            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
            task.wait(0.05)
            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
            
            task.wait(workoutSpeed)
        else
            task.wait(0.5)
        end
    end
end)


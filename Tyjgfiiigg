        if num then
            vehicleSpeedValue = math.clamp(num, 1, 100000)
            Fluent:Notify({ Title = "Bemo Vehicle", Content = "ตั้งค่าความเร็วเป็น: " .. tostring(vehicleSpeedValue), Duration = 2 })
        end
    end

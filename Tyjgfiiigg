local isTouchingGas = false
local isTouchingReverse = false
local isTouchingBrake = false

UserInputService.TouchStarted:Connect(function(touch, gameProcessed)
    local camera = workspace.CurrentCamera
    if not camera then return end
    local screenSize = camera.ViewportSize
    local posX = touch.Position.X / screenSize.X
    local posY = touch.Position.Y / screenSize.Y
    
    if posX >= 0.86 and posY >= 0.65 then isTouchingGas = true end
    if posX >= 0.73 and posX < 0.86 and posY >= 0.65 then isTouchingReverse = true end
    if posX >= 0.75 and posX <= 0.95 and posY >= 0.50 and posY < 0.65 then isTouchingBrake = true end
end)

UserInputService.TouchEnded:Connect(function(touch)
    local camera = workspace.CurrentCamera
    if not camera then return end
    local posX = touch.Position.X / screenSize.X
    
    if posX >= 0.70 then
        isTouchingGas = false
        isTouchingReverse = false
        isTouchingBrake = false
    end
end)

RunService.Stepped:Connect(function()
    if vehicleSpeedEnabled and LocalPlayer.Character then
        local humanoid = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if humanoid and humanoid.SeatPart then
            local seat = humanoid.SeatPart
            local rootPart = seat.Parent:IsA("Model") and (seat.Parent.PrimaryPart or seat) or seat
            
            if isTouchingBrake then
                rootPart.AssemblyLinearVelocity = Vector3.new(0, rootPart.AssemblyLinearVelocity.Y, 0)
                rootPart.AssemblyAngularVelocity = Vector3.zero
            elseif isTouchingGas then
                local forwardDir = rootPart.CFrame.LookVector
                rootPart.AssemblyLinearVelocity = Vector3.new(forwardDir.X * vehicleSpeedValue, rootPart.AssemblyLinearVelocity.Y, forwardDir.Z * vehicleSpeedValue)
            elseif isTouchingReverse then
                local backwardDir = -rootPart.CFrame.LookVector
                rootPart.AssemblyLinearVelocity = Vector3.new(backwardDir.X * vehicleSpeedValue, rootPart.AssemblyLinearVelocity.Y, backwardDir.Z * vehicleSpeedValue)
            end
        end
    end
end)

